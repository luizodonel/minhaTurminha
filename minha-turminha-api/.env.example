# Banco de Dados PostgreSQL (Coolify / Docker)
DATABASE_URL=jdbc:postgresql://host:5432/postgres?sslmode=allow
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=sua_senha_aqui

# Configurações do Servidor
PORT=8080
UPLOAD_DIR=uploads
